# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection (Reemplaza con tu URI de MongoDB Atlas)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/justimobile_pos?retryWrites=true&w=majority
DB_AUTO_PROVISION=true

# JWT Auth (Mobile-First: Access + Refresh Token)
JWT_ACCESS_SECRET=change_this_to_a_secure_access_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_to_a_secure_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=30d
